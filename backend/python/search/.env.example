APP_NAME=search-api
APP_HOST=0.0.0.0
APP_PORT=8000

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_INDEX=goods_search_v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false

GOODS_API_BASE_URL=http://goods-api:8080
GOODS_API_TIMEOUT_SECONDS=15
GOODS_SYNC_BATCH_SIZE=500
GOODS_SYNC_ENDPOINT=/api/v1/goods/sync
GOODS_ALL_ENDPOINT=/api/v1/goods/all
GOODS_SINGLE_ENDPOINT=/api/v1/goods/{id}

SYNC_INTERVAL_SECONDS=600
RUN_FULL_SYNC_ON_STARTUP=true
FORCE_FULL_SYNC_ON_STARTUP=false
SYNC_STATE_FILE=/app/data/sync_state.json
